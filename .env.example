# Copy to .env (docker compose) or paste into Portainer's "Environment variables".
# Every value here is a placeholder; none of them are real addresses.

# The PC to wake.
PC_NAME=My PC
# MAC of the PC's wired network card, e.g. from `ip link` on the PC.
PC_MAC=aa:bb:cc:dd:ee:ff
# The PC's IP, used to check whether it's on and to restrict the GRUB port.
# Give it a DHCP reservation so it doesn't change.
PC_IP=192.168.1.50

# Where the magic packet goes. Prefer your subnet's broadcast address
# (e.g. 192.168.1.255) over 255.255.255.255 so it leaves on the right interface.
WOL_BROADCAST=192.168.1.255
WOL_PORT=9

# Ports on the Docker host (host networking).
WEB_PORT=8080
GRUB_PROTOCOL_PORT=8081
BIND_ADDR=0.0.0.0

# What GRUB is told when nothing was chosen. The GRUB side always falls back
# to Linux if it can't reach Wake at all.
DEFAULT_BOOT=linux
# An unused choice expires after this long (0 = never).
BOOT_CHOICE_TTL=6h
# Repeat requests from the PC within this window get the same answer
# (GRUB can fetch more than once per boot). Keep it well under a reboot's length.
GRUB_REPEAT_WINDOW=60s
# Who may ask the GRUB port. Empty = only PC_IP (or anyone if PC_IP is empty).
# Comma-separated IPs, or "any".
GRUB_ALLOWED_IPS=

# How Wake decides the PC is on: any one answering counts.
# Windows drops ping by default; 3389 (RDP) or 445 (SMB) usually answer.
PROBE=icmp,tcp:22,tcp:3389,tcp:445
PROBE_INTERVAL=5s
WAKE_TIMEOUT=3m

# Optional. When set, the API and page need this token (Authorization: Bearer ...).
# Generate one with: openssl rand -hex 16
WAKE_TOKEN=

RUST_LOG=info
